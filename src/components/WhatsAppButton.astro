---
import Icon from './Icon.astro';
import { brand } from '@/config/brand';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<a
  href={brand.whatsapp}
  target="_blank"
  rel="noopener"
  aria-label={label}
  class="group fixed right-4 bottom-4 z-30 flex items-center gap-2 rounded-full bg-[#25D366] p-3.5 text-white shadow-lg shadow-black/20 transition hover:pr-5 sm:right-6 sm:bottom-6"
>
  <Icon name="whatsapp" class="size-6" />
  <span class="hidden text-sm font-medium group-hover:inline">{label}</span>
</a>
