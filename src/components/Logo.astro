---
// Placeholder wordmark. Replace with the client's logo, e.g. <img src="/logo.svg" ...>.
import { brand } from '@/config/brand';

interface Props {
  tone?: 'dark' | 'light';
}

const { tone = 'dark' } = Astro.props;
---

<span class:list={['flex items-center gap-2', tone === 'light' ? 'text-cream' : 'text-ink']}>
  <span
    class:list={[
      'grid size-9 place-items-center rounded-xl font-display text-sm font-semibold',
      tone === 'light' ? 'bg-cream text-ink' : 'bg-ink text-cream',
    ]}>VL</span
  >
  <span class="font-display text-sm font-semibold tracking-tight uppercase">{brand.name}</span>
</span>
