---
// Client logo from brand-guidelines/logo.jpeg, exported to public/brand/ as transparent PNGs.
// variant "full" = llama + wordmark, "mark" = llama only. tone "light" = white (for dark backgrounds).
import { brand } from '@/config/brand';

interface Props {
  variant?: 'full' | 'mark';
  tone?: 'dark' | 'light';
  class?: string;
}

const { variant = 'full', tone = 'light', class: className = 'h-10 w-auto' } = Astro.props;
const color = tone === 'light' ? 'white' : 'ink';
const src = variant === 'full' ? `/brand/logo-${color}.png` : `/brand/llama-${color}.png`;
const size = variant === 'full' ? { width: 1492, height: 631 } : { width: 481, height: 631 };
---

<img src={src} alt={brand.name} class={className} {...size} />
