---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  tone?: 'dark' | 'light';
}

const { eyebrow, title, lead, align = 'left', tone = 'dark' } = Astro.props;
const centered = align === 'center';
---

<div class:list={['max-w-2xl', centered && 'mx-auto text-center']} data-reveal>
  <p class:list={['eyebrow', tone === 'light' && 'text-sky/70']}>{eyebrow}</p>
  <h2 class:list={['mt-3 text-2xl leading-tight sm:text-3xl', tone === 'light' && 'text-paper']}>{title}</h2>
  {lead && <p class:list={['mt-4 text-base leading-relaxed', tone === 'light' ? 'text-sky/80' : 'text-muted']}>{lead}</p>}
</div>
