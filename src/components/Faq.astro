---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { Dict } from '@/i18n';

interface Props {
  t: Dict;
}

const { faq } = Astro.props.t;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section id="faq" class="bg-sky/50 py-24">
  <div class="container-x grid gap-12 lg:grid-cols-[1fr_1.6fr]">
    <SectionHeading eyebrow={faq.eyebrow} title={faq.title} />
    <div class="divide-y divide-ink/10 border-y border-ink/10" data-reveal>
      {
        faq.items.map((f, i) => (
          <details class="group py-5" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-base font-medium text-ink">
              {f.q}
              <Icon name="chevron" class="size-5 shrink-0 transition group-open:rotate-180" />
            </summary>
            <p class="mt-3 pr-10 text-sm leading-relaxed text-graphite">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>
