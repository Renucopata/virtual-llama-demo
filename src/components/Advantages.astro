---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { Dict } from '@/i18n';

interface Props {
  t: Dict;
}

const { advantages } = Astro.props.t;
---

<section id="advantages" class="bg-ink py-24 text-cream">
  <div class="container-x">
    <SectionHeading eyebrow={advantages.eyebrow} title={advantages.title} lead={advantages.lead} tone="light" />
    <div class="mt-14 grid gap-px overflow-hidden rounded-3xl bg-cream/10 sm:grid-cols-2 lg:grid-cols-3">
      {
        advantages.items.map((item, i) => (
          <article class="bg-ink p-8 transition hover:bg-graphite" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <Icon name={item.icon} class="size-8 text-accent" />
            <h3 class="mt-6 text-base text-cream">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-sand/75">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
