---
import { iconPaths } from './icons';

interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'size-6' } = Astro.props;
const d = iconPaths[name] ?? iconPaths.plus;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={d} />
</svg>
