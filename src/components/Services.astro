---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { Dict } from '@/i18n';

interface Props {
  t: Dict;
}

const { services } = Astro.props.t;
---

<section id="services" class="bg-white/50 py-24">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading eyebrow={services.eyebrow} title={services.title} lead={services.lead} />
      <a href="#contact" class="btn-ghost" data-reveal>{services.cta}<Icon name="arrow" class="size-4" /></a>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {
        services.items.map((s, i) => (
          <article
            class="group flex flex-col rounded-3xl bg-paper p-8 ring-1 ring-ink/5 transition hover:-translate-y-1 hover:shadow-xl hover:shadow-ink/5"
            data-reveal
            style={`--reveal-delay:${(i % 2) * 90}ms`}
          >
            <div class="flex items-center justify-between">
              <span class="grid size-14 place-items-center rounded-2xl bg-ink text-paper transition group-hover:bg-primary group-hover:text-white">
                <Icon name={s.icon} class="size-7" />
              </span>
              <span class="font-display text-3xl text-primary/40">0{i + 1}</span>
            </div>
            <h3 class="mt-8 text-lg leading-snug">{s.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-graphite">{s.text}</p>
            <ul class="mt-6 space-y-2 border-t border-ink/10 pt-6">
              {s.bullets.map((b) => (
                <li class="flex items-center gap-2 text-sm text-muted">
                  <Icon name="check" class="size-4 text-ink" />
                  {b}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
