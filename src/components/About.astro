---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import type { Dict } from '@/i18n';

interface Props {
  t: Dict;
}

const { about, team } = Astro.props.t;
---

<section id="about" class="py-24">
  <div class="container-x grid gap-14 lg:grid-cols-2">
    <div>
      <SectionHeading eyebrow={about.eyebrow} title={about.title} />
      <div class="mt-6 space-y-4 text-base leading-relaxed text-graphite" data-reveal>
        {about.story.map((p) => <p>{p}</p>)}
      </div>
      <!-- Placeholder for a team or office photo -->
      <div class="mt-10 aspect-[4/3] rounded-3xl bg-gradient-to-br from-sky to-paper ring-1 ring-ink/5" data-reveal role="img" aria-label="Team photo placeholder"></div>
    </div>

    <div>
      <h3 class="eyebrow" data-reveal>{about.valuesTitle}</h3>
      <ul class="mt-6 space-y-4">
        {
          about.values.map((v, i) => (
            <li class="flex gap-5 rounded-2xl bg-white/60 p-6 ring-1 ring-ink/5" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-ink text-paper">
                <Icon name={v.icon} class="size-6" />
              </span>
              <div>
                <h4 class="text-base">{v.title}</h4>
                <p class="mt-2 text-sm leading-relaxed text-muted">{v.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container-x mt-24">
    <SectionHeading eyebrow={team.eyebrow} title={team.title} lead={team.lead} align="center" />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        team.items.map((m, i) => (
          <article class="rounded-3xl bg-sky/60 p-7" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <Icon name={m.icon} class="size-8 text-ink" />
            <h3 class="mt-5 text-sm">{m.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-graphite">{m.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
